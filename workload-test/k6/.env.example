# Request settings shared by separate read and write tests.
BASE_URL=http://localhost:8080
METHOD=GET
REQUEST_TIMEOUT=5s

# Optional full URL overrides; leave empty to use BASE_URL/db and BASE_URL/dp.
READ_URL=
WRITE_URL=

# Dashboard settings. run.sh names reports by profile and operation.
K6_WEB_DASHBOARD=true
K6_WEB_DASHBOARD_PERIOD=1s
K6_WEB_DASHBOARD_EXPORT=load-read.html
